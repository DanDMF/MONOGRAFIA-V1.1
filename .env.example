# VRBAN — variáveis de ambiente. Copiar para .env e preencher. Nunca guardar credenciais reais neste ficheiro.

# Ligação PostgreSQL (obrigatória). Exemplo local inofensivo:
DATABASE_URL=postgres://vrban:vrban@127.0.0.1:5432/vrban

# Base usada pelos testes automáticos (será limpa e recriada pelos testes; nunca apontar para dados reais).
TEST_DATABASE_URL=postgres://vrban:vrban@127.0.0.1:5432/vrban_test

# Porta e endereço do servidor HTTP da aplicação.
PORT=3000
HOST=127.0.0.1

# URL pública do site (usada em "Como citar" e ligações absolutas). Sem barra final.
PUBLIC_BASE_URL=http://localhost:5173

# Diretório de armazenamento persistente de ficheiros (implementação local).
# Em alojamento, usar um volume persistente: discos efémeros perdem os ficheiros a cada reinício.
STORAGE_DIR=./storage

# "production" ativa cookies Secure e desativa rotas de teste.
NODE_ENV=development

# Duração da sessão autenticada, em horas.
SESSION_TTL_HOURS=336

# Projeto apresentado na raiz "/" do site público (opcional; por omissão, o único projeto com publicação ativa).
# PUBLIC_PROJECT_SLUG=vrban

# Exportação PDF: interpretador Python com o módulo `uno` do LibreOffice (omissão: python3).
# LIBREOFFICE_PYTHON=/usr/bin/python3

# ---- Alojamento sem terminal (ver docs/DEPLOY.md) ----
# Aplicar migrações ao arrancar (nunca apagam dados).
# MIGRATE_ON_START=true
# Correr a fila de exportações no mesmo processo web (um único serviço).
# RUN_WORKER_IN_PROCESS=true
# Guardar ficheiros exportados na base de dados em vez do disco (discos efémeros perdem ficheiros).
# STORAGE_DRIVER=db
# Criar o primeiro autor no arranque SE a base não tiver contas. Apagar a palavra-passe depois do primeiro arranque.
# VRBAN_BOOTSTRAP_EMAIL=autor@exemplo.org
# VRBAN_BOOTSTRAP_NAME=Nome do Autor
# VRBAN_BOOTSTRAP_PASSWORD=
# VRBAN_BOOTSTRAP_PROJECT=vrban
